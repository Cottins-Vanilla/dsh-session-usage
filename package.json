{
  "name": "dsh-session-usage",
  "version": "1.4.2",
  "private": true,
  "description": "Session usage dashboard for DeepSeek Harness: price, tokens, per-turn curves, and per-answer cost badges.",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "docs/*.md",
    "examples/*.yml",
    "scripts/*.mjs",
    "tests/*.mjs"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node --test tests/usage.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "token-usage",
    "cost",
    "dashboard",
    "observability"
  ],
  "author": "Cottins-Vanilla",
  "license": "MIT",
  "homepage": "https://github.com/Cottins-Vanilla/dsh-session-usage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cottins-Vanilla/dsh-session-usage.git"
  },
  "bugs": {
    "url": "https://github.com/Cottins-Vanilla/dsh-session-usage/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}

